@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Alivia - C4 Nivel 2: Contenedores de la Fog Layer

Person(assisted, "Persona asistida")
System_Ext(cloud, "Alivia API", "Backend cloud")

System_Boundary(home, "Fog Layer / Red local de la vivienda") {
  Container(mic, "Embedded Microphone", "C++ / firmware", "Captura audio y reproduce respuestas")
  Container(control, "Control Edge Service", "Python / Flask", "Inferencia, validación y orquestación")
  ContainerDb(controlDb, "Control Edge SQLite", "SQLite", "Permisos, comandos, inbox y outbox")
  Container(broker, "Message Broker", "MQTT", "Enruta comandos y resultados entre edges")
  Container(actuatorEdge, "Actuator Edge Service", "Python / Flask", "Ejecuta comandos y confirma estados")
  ContainerDb(actuatorDb, "Actuator Edge SQLite", "SQLite", "Permisos, acciones y estado local")
  Container(actuator, "Embedded Actuator", "C++ / firmware", "Controla el hardware físico")
}

Rel(assisted, mic, "Habla / escucha")
Rel_Bidirectional(mic, control, "Audio binario, eventos y respuestas", "WebSocket")
Rel(control, controlDb, "Lee/escribe", "SQL")
Rel(control, broker, "Publica comandos", "MQTT QoS 1")
Rel(broker, control, "Entrega resultados", "MQTT QoS 1")
Rel(broker, actuatorEdge, "Entrega comandos", "MQTT QoS 1")
Rel(actuatorEdge, broker, "Publica resultados", "MQTT QoS 1")
Rel(actuatorEdge, actuatorDb, "Lee/escribe", "SQL")
Rel_Bidirectional(actuatorEdge, actuator, "Acción y estado confirmado", "HTTP local / BLE")
Rel_Bidirectional(control, cloud, "Tabla de acceso y telemetría", "HTTPS")

SHOW_LEGEND()
@enduml
