@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Alivia - C4 Nivel 3: Componentes del Control Edge

Container_Ext(mic, "Embedded Microphone", "Firmware")
Container_Ext(broker, "MQTT Broker", "Broker local")
Container_Ext(cloud, "Alivia API", "Cloud")
ContainerDb_Ext(db, "SQLite", "Persistencia local")

Container_Boundary(edge, "Control Edge Service") {
  Component(ws, "Microphone WebSocket Gateway", "Interface adapter", "Sesiones, frames, heartbeat y respuestas")
  Component(process, "Process Voice Capture", "Application service", "Orquesta captura e inferencia")
  Component(inference, "Voice Inference Adapter", "Infrastructure adapter", "Obtiene intención y confianza")
  Component(dispatch, "Dispatch Device Command", "Application service", "Valida, persiste y despacha")
  Component(domain, "Device Control Domain", "Domain model", "Comandos, ejecuciones, políticas y eventos")
  Component(access, "IAM", "Local supporting bounded context", "Autentica el dispositivo y valida nodos y tabla de acceso")
  Component(mqttOut, "MQTT Command Publisher", "Infrastructure adapter", "Publica comandos")
  Component(mqttIn, "MQTT Result Consumer", "Interface adapter", "Consume resultados")
  Component(results, "Handle Execution Result", "Application service", "Correlaciona y responde")
  Component(telemetry, "Telemetry / Outbox Sync", "Supporting component", "Persiste y sincroniza eventos")
}

Rel_Bidirectional(mic, ws, "Audio, control y confirmaciones", "WebSocket")
Rel(ws, access, "Autoriza sesión")
Rel(ws, process, "Entrega captura")
Rel(process, inference, "Solicita inferencia")
Rel(process, dispatch, "Crea intención validada")
Rel(dispatch, domain, "Aplica reglas")
Rel(dispatch, access, "Autoriza destino")
Rel(dispatch, db, "Comando + outbox", "SQL transaction")
Rel(dispatch, mqttOut, "Despacha")
Rel(mqttOut, broker, "Comando", "MQTT")
Rel(broker, mqttIn, "Resultado", "MQTT")
Rel(mqttIn, results, "Entrega resultado")
Rel(results, domain, "Completa ejecución")
Rel(results, db, "Inbox + estado", "SQL transaction")
Rel(results, ws, "Respuesta correlacionada")
Rel(results, telemetry, "Registra evento")
Rel(telemetry, db, "Lee outbox", "SQL")
Rel(telemetry, cloud, "Sincroniza", "HTTPS")

SHOW_LEGEND()
@enduml
