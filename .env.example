EDGE_DATABASE_PATH=control-edge.db
PORT=5001
EDGE_ID=control-edge-01
EDGE_NETWORK_ID=local-network
CONFIDENCE_THRESHOLD=0.75
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
CLOUD_API_URL=
EDGE_SETUP_TOKEN=replace-with-a-random-secret

# --- Edge de voz (alivia_edge) ---
ALIVIA_WS_HOST=0.0.0.0
ALIVIA_WS_PORT=8765
ALIVIA_WS_PATH=/ws
# Secreto compartido con Secrets.h del ESP32 (obligatorio; genera uno aleatorio).
ALIVIA_WS_TOKEN=replace-with-a-random-secret
ALIVIA_VOSK_MODEL=models/vosk-model-small-es-0.42
ALIVIA_WHISPER_MODEL=large-v3-turbo
ALIVIA_PIPER_VOICE=models/piper/es_ES-davefx-medium.onnx
ALIVIA_OLLAMA_URL=http://localhost:11434
ALIVIA_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
ALIVIA_CONFIRM_WINDOW_S=8
ALIVIA_VAD_END_MS=700
ALIVIA_ECHO_TAIL_MS=300
ALIVIA_ACTUATOR_TIMEOUT_S=8
ALIVIA_STATUS_PATH=data/voice-status.json

# --- Emergencia (único tráfico a Internet) ---
# PLACEHOLDER: el endpoint real aún no existe. El dominio .example nunca resuelve, así que no sale tráfico.
# /health y /status marcan el camino como "placeholder / no configurado" mientras esto no se reemplace.
ALIVIA_BACKEND_URL=https://api.alivia.example
EMERGENCY_PATH=/api/v1/emergencies
EMERGENCY_API_TOKEN=changeme
ALIVIA_EMERGENCY_QUEUE_PATH=data/emergency-queue.db
